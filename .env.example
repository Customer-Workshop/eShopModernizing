# Copy to .env and fill in real values: `cp .env.example .env`. .env is git-ignored — never commit
# a real password.

# SQL Server sa password. Required in database mode; must satisfy the SQL Server password policy
# (>= 8 characters with upper case, lower case, digits and symbols).
MSSQL_SA_PASSWORD=change-me-Str0ng!Passw0rd

# SQL Server edition. Developer and Express are free for non-production use.
MSSQL_PID=Developer

# Optional: override the whole catalog connection string (for an external SQL Server).
# CATALOG_CONNECTION_STRING=Server=my-sql-host,1433;Database=CatalogDb;User Id=eshop;Password=...;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True

# Published host ports.
WEB_PORT=8080
API_PORT=8081
GRPC_PORT=8082
SQLSERVER_PORT=1433

# Address the catalog API is reachable at from the browser; the MVC front end renders it into the
# item picture <img> URLs. Must match API_PORT.
CATALOG_API_PUBLIC_URL=http://localhost:8081

# Production (default) or Development (developer exception page, verbose logging).
ASPNETCORE_ENVIRONMENT=Production

# Seed from Setup/*.csv (and extract Setup/CatalogItems.zip) instead of the preconfigured data set.
CATALOG_USE_CUSTOMIZATION_DATA=false

# Image tag used for the three application images.
ESHOP_TAG=local
