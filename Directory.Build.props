<Project>

  <!--
    Shared MSBuild settings for the modernized .NET 8 solution (eShop.sln).

    IMPORTANT: this file sits at the repository root, so MSBuild also imports it for the
    legacy .NET Framework projects under eShopLegacy*/ . Every setting below is therefore
    scoped to projects that live under src/ or tests/ (the modernized solution), leaving the
    legacy solutions byte-for-byte unaffected.
  -->
  <PropertyGroup>
    <_RepoRootNormalized>$(MSBuildThisFileDirectory.Replace('\','/'))</_RepoRootNormalized>
    <_ProjectDirNormalized>$(MSBuildProjectDirectory.Replace('\','/'))/</_ProjectDirNormalized>
    <IsModernizedProject>false</IsModernizedProject>
    <IsModernizedProject Condition="$(_ProjectDirNormalized.StartsWith('$(_RepoRootNormalized)src/'))">true</IsModernizedProject>
    <IsModernizedProject Condition="$(_ProjectDirNormalized.StartsWith('$(_RepoRootNormalized)tests/'))">true</IsModernizedProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsModernizedProject)' == 'true'">
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- No binding redirects anywhere in the modernized estate -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsModernizedProject)' == 'true' AND $(_ProjectDirNormalized.StartsWith('$(_RepoRootNormalized)tests/'))">
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

</Project>
