@model CatalogItemFormViewModel

@{
    ViewData["Title"] = "Create";
}

<h2 class="esh-body-title">Create</h2>


<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Item.Name" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.Name" class="form-control" />
                <span asp-validation-for="Item.Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.Description" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.Description" class="form-control" />
                <span asp-validation-for="Item.Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.CatalogBrandId" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <select asp-for="Item.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
                <span asp-validation-for="Item.CatalogBrandId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.CatalogTypeId" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <select asp-for="Item.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
                <span asp-validation-for="Item.CatalogTypeId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.Price" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.Price" class="form-control" />
                <span asp-validation-for="Item.Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.PictureFileName" class="control-label col-md-2"></label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.AvailableStock" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.AvailableStock" class="form-control" />
                <span asp-validation-for="Item.AvailableStock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.RestockThreshold" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.RestockThreshold" class="form-control" />
                <span asp-validation-for="Item.RestockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Item.MaxStockThreshold" class="control-label col-md-2"></label>
            <div class="col-md-3">
                <input asp-for="Item.MaxStockThreshold" class="form-control" />
                <span asp-validation-for="Item.MaxStockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a asp-action="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <input type="submit" value="[ Create ]" class="btn esh-button esh-button-primary" />
            </div>
        </div>
    </div>
</form>

<div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
