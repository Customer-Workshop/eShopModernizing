<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Overrides the central net8.0 from Directory.Build.props: this is the one Windows-only
         project in the modernized solution. EnableWindowsTargeting lets the Linux CI job compile
         it (reference assemblies come from NuGet); only publishing needs a Windows agent. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>eShop.WinForms.Client</RootNamespace>
    <AssemblyName>eShop.WinForms.Client</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier Condition="'$(PublishSelfContained)' == 'true'">win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\eShop.Catalog.Domain\eShop.Catalog.Domain.csproj" />
    <ProjectReference Include="..\eShop.Catalog.Grpc.Client\eShop.Catalog.Grpc.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
