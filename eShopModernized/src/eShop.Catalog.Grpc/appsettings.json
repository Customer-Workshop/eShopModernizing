{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "ConnectionStrings": {
    "Catalog": ""
  },
  "Catalog": {
    "UseMockData": false,
    "UseCustomizationData": false,
    "PicsFolder": "Pics",
    "SetupFolder": "Setup"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "logs/myapp.log",
          "rollingInterval": "Infinite",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 10485760,
          "retainedFileCountLimit": 5,
          "shared": true
        }
      }
    ]
  },
  "OpenTelemetry": {
    "Enabled": true,
    "Otlp": {
      "Endpoint": "",
      "Protocol": "grpc"
    },
    "AzureMonitor": {
      "ConnectionString": ""
    }
  }
}
