@model PaginatedItemsViewModel<CatalogItem>

@{
    ViewData["Title"] = "Index";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        <a asp-action="Create" class="btn esh-button esh-button-primary">Create New</a>
    </p>

    <partial name="CatalogTable" model="Model.Data" />

    <div class="esh-pager">
        <div class="container">
            <article class="esh-pager-wrapper row">
                <nav>
                    <a asp-action="Index"
                       asp-route-pageSize="@Model.ItemsPerPage"
                       asp-route-pageIndex="@(Model.ActualPage - 1)"
                       class="esh-pager-item esh-pager-item--navigable @(Model.ActualPage > 0 ? string.Empty : "esh-pager-item--hidden")">Previous</a>

                    <span class="esh-pager-item">
                        Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                    </span>

                    <a asp-action="Index"
                       asp-route-pageSize="@Model.ItemsPerPage"
                       asp-route-pageIndex="@(Model.ActualPage + 1)"
                       class="esh-pager-item esh-pager-item--navigable @(Model.ActualPage < Model.TotalPages - 1 ? string.Empty : "esh-pager-item--hidden")">Next</a>
                </nav>
            </article>
        </div>
    </div>
</div>
