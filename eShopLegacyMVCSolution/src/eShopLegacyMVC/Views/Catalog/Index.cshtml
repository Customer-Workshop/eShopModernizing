@using System.Linq
@using System.Web.Mvc
@model eShopLegacyMVC.ViewModel.PaginatedItemsViewModel<eShopLegacyMVC.Models.CatalogItem>

@{
    ViewBag.Title = "Index";
    var brands = Model.Brands ?? new SelectList(Enumerable.Empty<object>());
    var types = Model.Types ?? new SelectList(Enumerable.Empty<object>());
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn esh-button esh-button-primary" })
    </p>

    <div class="esh-filters">
        @using (Html.BeginForm("Index", "Catalog", FormMethod.Get, new { @class = "esh-filters-form form-inline" }))
        {
            <input type="text" name="searchText" value="@Model.SearchText" placeholder="Search by name" class="form-control esh-filters-input" />
            @Html.DropDownList("brandId", brands, "All brands", new { @class = "form-control esh-filters-select" })
            @Html.DropDownList("typeId", types, "All types", new { @class = "form-control esh-filters-select" })
            <input type="hidden" name="pageSize" value="@Model.ItemsPerPage" />
            <input type="submit" value="Search" class="btn esh-button esh-button-primary" />
            @Html.ActionLink("Clear", "Index", null, new { @class = "esh-link-item" })
        }
    </div>

    @Html.Partial("CatalogTable", Model.Data)

    <div class="esh-pager">
        <div class="container">
            <article class="esh-pager-wrapper row">
                <nav>

                    @if (Model.ActualPage > 0)
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchText = Model.SearchText, brandId = Model.BrandId, typeId = Model.TypeId }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchText = Model.SearchText, brandId = Model.BrandId, typeId = Model.TypeId }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

                    <span class="esh-pager-item">
                        Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                    </span>

                    @if (Model.ActualPage < Model.TotalPages - 1)
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchText = Model.SearchText, brandId = Model.BrandId, typeId = Model.TypeId }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchText = Model.SearchText, brandId = Model.BrandId, typeId = Model.TypeId }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

            </nav>
        </article>
    </div>
</div>

</div>
