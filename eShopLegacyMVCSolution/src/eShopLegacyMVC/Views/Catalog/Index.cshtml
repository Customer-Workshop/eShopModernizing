@model eShopLegacyMVC.ViewModel.PaginatedItemsViewModel<eShopLegacyMVC.Models.CatalogItem>

@{
    ViewBag.Title = "Index";
    string searchName = ViewBag.SearchName;
    int? brandId = ViewBag.BrandId;
    int? typeId = ViewBag.TypeId;
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn esh-button esh-button-primary" })
    </p>

    <div class="esh-filter">
        @using (Html.BeginForm("Index", "Catalog", FormMethod.Get, new { @class = "esh-filter-form" }))
        {
            <input type="hidden" name="pageSize" value="@Model.ItemsPerPage" />
            <div class="esh-filter-group">
                <label class="esh-filter-label" for="searchName">Product name</label>
                @Html.TextBox("searchName", searchName, new { @class = "form-control esh-filter-control", placeholder = "Search products" })
            </div>
            <div class="esh-filter-group">
                <label class="esh-filter-label" for="brandId">Brand</label>
                @Html.DropDownList("brandId", (SelectList)ViewBag.CatalogBrands, "All brands", new { @class = "form-control esh-filter-control" })
            </div>
            <div class="esh-filter-group">
                <label class="esh-filter-label" for="typeId">Type</label>
                @Html.DropDownList("typeId", (SelectList)ViewBag.CatalogTypes, "All types", new { @class = "form-control esh-filter-control" })
            </div>
            <div class="esh-filter-actions">
                <button type="submit" class="btn esh-button esh-button-primary">Filter</button>
                @Html.ActionLink("Clear", "Index", new { pageSize = Model.ItemsPerPage }, new { @class = "btn esh-button esh-button-secondary" })
            </div>
        }
    </div>

    @Html.Partial("CatalogTable", Model.Data)

    <div class="esh-pager">
        <div class="container">
            <article class="esh-pager-wrapper row">
                <nav>

                    @if (Model.ActualPage > 0)
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchName, brandId, typeId }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchName, brandId, typeId }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

                    <span class="esh-pager-item">
                        Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                    </span>

                    @if (Model.ActualPage < Model.TotalPages - 1)
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchName, brandId, typeId }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchName, brandId, typeId }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

            </nav>
        </article>
    </div>
</div>

</div>
