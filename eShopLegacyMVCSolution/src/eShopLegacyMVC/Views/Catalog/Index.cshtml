@model eShopLegacyMVC.ViewModel.PaginatedItemsViewModel<eShopLegacyMVC.Models.CatalogItem>

@{
    ViewBag.Title = "Index";
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn esh-button esh-button-primary" })
    </p>

    <div class="esh-filter-wrapper">
        @using (Html.BeginForm("Index", "Catalog", FormMethod.Get, new { @class = "form-inline" }))
        {
            <input type="hidden" name="pageSize" value="@Model.ItemsPerPage" />
            <label for="searchName">Name</label>
            <input type="text" id="searchName" name="searchName" class="form-control" value="@ViewBag.SearchName" placeholder="Search by name..." />
            <label for="catalogBrandId">Brand</label>
            @Html.DropDownList("catalogBrandId", (SelectList)ViewBag.CatalogBrandId, "All", new { @class = "form-control" })
            <label for="catalogTypeId">Type</label>
            @Html.DropDownList("catalogTypeId", (SelectList)ViewBag.CatalogTypeId, "All", new { @class = "form-control" })
            <button type="submit" class="btn esh-button esh-button-primary">Filter</button>
        }
    </div>

    @Html.Partial("CatalogTable", Model.Data)

    <div class="esh-pager">
        <div class="container">
            <article class="esh-pager-wrapper row">
                <nav>

                    @if (Model.ActualPage > 0)
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchName = (string)ViewBag.SearchName, catalogBrandId = (int?)((SelectList)ViewBag.CatalogBrandId).SelectedValue, catalogTypeId = (int?)((SelectList)ViewBag.CatalogTypeId).SelectedValue }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Previous", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage - 1, searchName = (string)ViewBag.SearchName, catalogBrandId = (int?)((SelectList)ViewBag.CatalogBrandId).SelectedValue, catalogTypeId = (int?)((SelectList)ViewBag.CatalogTypeId).SelectedValue }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

                    <span class="esh-pager-item">
                        Showing @Model.ItemsPerPage of @Model.TotalItems products - Page @(Model.ActualPage + 1) - @Model.TotalPages
                    </span>

                    @if (Model.ActualPage < Model.TotalPages - 1)
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchName = (string)ViewBag.SearchName, catalogBrandId = (int?)((SelectList)ViewBag.CatalogBrandId).SelectedValue, catalogTypeId = (int?)((SelectList)ViewBag.CatalogTypeId).SelectedValue }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                    }
                    else
                    {
                        @Html.ActionLink("Next", "Index", new { pageSize = Model.ItemsPerPage, pageIndex = Model.ActualPage + 1, searchName = (string)ViewBag.SearchName, catalogBrandId = (int?)((SelectList)ViewBag.CatalogBrandId).SelectedValue, catalogTypeId = (int?)((SelectList)ViewBag.CatalogTypeId).SelectedValue }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                    }

            </nav>
        </article>
    </div>
</div>

</div>
