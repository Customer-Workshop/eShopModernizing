@model eShopLegacyMVC.ViewModel.CatalogIndexViewModel

@{
    ViewBag.Title = "Index";
    var hasItems = Model.Items.Data != null && Model.Items.Data.Any();
    var sortOptions = new[]
    {
        new { Value = "name-asc", Text = "Name A-Z" },
        new { Value = "name-desc", Text = "Name Z-A" },
        new { Value = "price-asc", Text = "Price low-high" },
        new { Value = "price-desc", Text = "Price high-low" }
    };
    var selectedBrand = Model.Query.BrandId.HasValue && Model.Brands != null
        ? Model.Brands.FirstOrDefault(brand => brand.Id == Model.Query.BrandId.Value)
        : null;
    var selectedType = Model.Query.TypeId.HasValue && Model.Types != null
        ? Model.Types.FirstOrDefault(type => type.Id == Model.Query.TypeId.Value)
        : null;
}

<div class="esh-table">
    <p class="esh-link-wrapper">
        @Html.ActionLink("Create New", "Create", null, new { @class = "btn esh-button esh-button-primary" })
    </p>

    @using (Html.BeginForm("Index", "Catalog", FormMethod.Get, new { @class = "esh-filter-bar" }))
    {
        <div class="esh-filter-field esh-filter-field--search">
            @Html.Label("search", "Search", new { @class = "esh-filter-label" })
            @Html.TextBox("search", Model.Query.Search, new { @class = "form-control", placeholder = "Name or description" })
        </div>
        <div class="esh-filter-field">
            @Html.Label("brandId", "Brand", new { @class = "esh-filter-label" })
            @Html.DropDownList("brandId", new SelectList(Model.Brands, "Id", "Brand", Model.Query.BrandId), "All brands", new { @class = "form-control" })
        </div>
        <div class="esh-filter-field">
            @Html.Label("typeId", "Type", new { @class = "esh-filter-label" })
            @Html.DropDownList("typeId", new SelectList(Model.Types, "Id", "Type", Model.Query.TypeId), "All types", new { @class = "form-control" })
        </div>
        <div class="esh-filter-field">
            @Html.Label("sort", "Sort by", new { @class = "esh-filter-label" })
            @Html.DropDownList("sort", new SelectList(sortOptions, "Value", "Text", Model.Query.Sort), new { @class = "form-control" })
        </div>
        @Html.Hidden("pageSize", Model.Query.PageSize)
        <div class="esh-filter-actions">
            <button type="submit" class="btn esh-button esh-button-primary">Apply</button>
            @Html.ActionLink("Clear", "Index", new { pageSize = Model.Query.PageSize }, new { @class = "esh-filter-clear" })
        </div>
    }

    @if (Model.Query.HasFilters)
    {
        <p class="esh-filter-summary">
            Active filters:
            @if (!string.IsNullOrWhiteSpace(Model.Query.Search))
            {
                <span class="esh-filter-summary-item">Search: <strong>@Model.Query.Search</strong></span>
            }
            @if (Model.Query.BrandId.HasValue)
            {
                <span class="esh-filter-summary-item">Brand: <strong>@(selectedBrand == null ? Model.Query.BrandId.ToString() : selectedBrand.Brand)</strong></span>
            }
            @if (Model.Query.TypeId.HasValue)
            {
                <span class="esh-filter-summary-item">Type: <strong>@(selectedType == null ? Model.Query.TypeId.ToString() : selectedType.Type)</strong></span>
            }
        </p>
    }

    @if (hasItems)
    {
        ViewData["CatalogSearch"] = Model.Query.Search;
        ViewData["CatalogBrandId"] = Model.Query.BrandId;
        ViewData["CatalogTypeId"] = Model.Query.TypeId;
        ViewData["CatalogSort"] = Model.Query.Sort;
        ViewData["CatalogPageSize"] = Model.Query.PageSize;
        @Html.Partial("CatalogTable", Model.Items.Data, ViewData)
    }
    else
    {
        <div class="esh-empty-state">
            <p>No products match your filters.</p>
            @Html.ActionLink("Clear", "Index", new { pageSize = Model.Query.PageSize }, new { @class = "esh-filter-clear" })
        </div>
    }

    @if (hasItems)
    {
        <div class="esh-pager">
            <div class="container">
                <article class="esh-pager-wrapper row">
                    <nav>
                        @if (Model.Items.ActualPage > 0)
                        {
                            @Html.ActionLink("Previous", "Index", new { search = Model.Query.Search, brandId = Model.Query.BrandId, typeId = Model.Query.TypeId, sort = Model.Query.Sort, pageSize = Model.Items.ItemsPerPage, pageIndex = Model.Items.ActualPage - 1 }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                        }
                        else
                        {
                            @Html.ActionLink("Previous", "Index", new { search = Model.Query.Search, brandId = Model.Query.BrandId, typeId = Model.Query.TypeId, sort = Model.Query.Sort, pageSize = Model.Items.ItemsPerPage, pageIndex = Model.Items.ActualPage - 1 }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                        }
                        <span class="esh-pager-item">
                            Showing @Model.Items.ItemsPerPage of @Model.Items.TotalItems products - Page @(Model.Items.ActualPage + 1) - @Model.Items.TotalPages
                        </span>
                        @if (Model.Items.ActualPage < Model.Items.TotalPages - 1)
                        {
                            @Html.ActionLink("Next", "Index", new { search = Model.Query.Search, brandId = Model.Query.BrandId, typeId = Model.Query.TypeId, sort = Model.Query.Sort, pageSize = Model.Items.ItemsPerPage, pageIndex = Model.Items.ActualPage + 1 }, new { @class = "esh-pager-item esh-pager-item--navigable" })
                        }
                        else
                        {
                            @Html.ActionLink("Next", "Index", new { search = Model.Query.Search, brandId = Model.Query.BrandId, typeId = Model.Query.TypeId, sort = Model.Query.Sort, pageSize = Model.Items.ItemsPerPage, pageIndex = Model.Items.ActualPage + 1 }, new { @class = "esh-pager-item esh-pager-item--navigable esh-pager-item--hidden" })
                        }
                    </nav>
                </article>
            </div>
        </div>
    }
</div>
