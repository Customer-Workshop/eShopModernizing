@model CatalogItem
@{
    ViewData["Title"] = "Delete";
}

<h2 class="esh-body-title">Delete</h2>

<div class="container">
    <h3>Are you sure you want to delete this?</h3>
    <div class="row">
        <img class="col-md-6 esh-picture" src="@Url.RouteUrl("GetPicRouteTemplate", new { catalogItemId = Model.Id })" />
        <dl class="col-md-6 dl-horizontal">
            <dt>Name</dt>
            <dd>@Model.Name</dd>

            <dt>Description</dt>
            <dd>@Model.Description</dd>

            <dt>Brand</dt>
            <dd>@Model.CatalogBrand?.Brand</dd>

            <dt>Type</dt>
            <dd>@Model.CatalogType?.Type</dd>

            <dt>Price</dt>
            <dd><span class="esh-price">@Model.Price</span></dd>

            <dt>Picture name</dt>
            <dd>@Model.PictureFileName</dd>

            <dt>Stock</dt>
            <dd>@Model.AvailableStock</dd>

            <dt>Restock</dt>
            <dd>@Model.RestockThreshold</dd>

            <dt>Max stock</dt>
            <dd>@Model.MaxStockThreshold</dd>

            <dt></dt>
            <dd class="text-right esh-button-actions">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a asp-action="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <button type="submit" class="btn esh-button esh-button-primary">[ Delete ]</button>
                </form>
            </dd>
        </dl>
    </div>
</div>
