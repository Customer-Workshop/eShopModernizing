@model CatalogIndexViewModel
@{
    ViewData["Title"] = "Index";
}

<h2 class="esh-body-title">Catalog manager (MVC)</h2>

<div class="esh-table">
    <form method="get" asp-action="Index" class="form-inline esh-filter">
        <label class="control-label">Brand</label>
        <select name="brandFilter" asp-items="Model.Brands" class="form-control">
            <option value="">All</option>
        </select>

        <label class="control-label">Type</label>
        <select name="typeFilter" asp-items="Model.Types" class="form-control">
            <option value="">All</option>
        </select>

        <input type="hidden" name="pageSize" value="@Model.Items.ItemsPerPage" />
        <button type="submit" class="btn esh-button esh-button-primary">Filter</button>
    </form>

    <p class="esh-link-wrapper">
        <a asp-action="Create" class="btn esh-button esh-button-primary">Create New</a>
    </p>

    @if (!Model.Items.Data.Any())
    {
        <table>
            <tr>
                <td>No data was returned.</td>
            </tr>
        </table>
    }
    else
    {
        <table class="table">
            <thead>
                <tr class="esh-table-header">
                    <th></th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Brand</th>
                    <th>Type</th>
                    <th>Price</th>
                    <th>Picture name</th>
                    <th>Stock</th>
                    <th>Restock</th>
                    <th>Max stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items.Data)
                {
                    <tr>
                        <td><img class="esh-thumbnail" src="@Url.RouteUrl("GetPicRouteTemplate", new { catalogItemId = item.Id })" /></td>
                        <td><p>@item.Name</p></td>
                        <td><p>@item.Description</p></td>
                        <td><p>@item.CatalogBrand?.Brand</p></td>
                        <td><p>@item.CatalogType?.Type</p></td>
                        <td><p><span class="esh-price">@item.Price</span></p></td>
                        <td><p>@item.PictureFileName</p></td>
                        <td><p>@item.AvailableStock</p></td>
                        <td><p>@item.RestockThreshold</p></td>
                        <td><p>@item.MaxStockThreshold</p></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="esh-table-link">Edit</a>
                            |
                            <a asp-action="Details" asp-route-id="@item.Id" class="esh-table-link">Details</a>
                            |
                            <a asp-action="Delete" asp-route-id="@item.Id" class="esh-table-link">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="esh-pager">
    <div class="container">
        <article class="esh-pager-wrapper row">
            <nav>
                @if (Model.Items.ActualPage > 0)
                {
                    <a class="esh-pager-item esh-pager-item--navigable"
                       asp-action="Index"
                       asp-route-pageIndex="@(Model.Items.ActualPage - 1)"
                       asp-route-pageSize="@Model.Items.ItemsPerPage"
                       asp-route-brandFilter="@Model.BrandFilter"
                       asp-route-typeFilter="@Model.TypeFilter">Previous</a>
                }

                <span class="esh-pager-item">
                    Showing @Model.Items.ItemsPerPage of @Model.Items.TotalItems products - Page @(Model.Items.ActualPage + 1) - @Model.Items.TotalPages
                </span>

                @if (Model.Items.ActualPage < Model.Items.TotalPages - 1)
                {
                    <a class="esh-pager-item esh-pager-item--navigable"
                       asp-action="Index"
                       asp-route-pageIndex="@(Model.Items.ActualPage + 1)"
                       asp-route-pageSize="@Model.Items.ItemsPerPage"
                       asp-route-brandFilter="@Model.BrandFilter"
                       asp-route-typeFilter="@Model.TypeFilter">Next</a>
                }
            </nav>
        </article>
    </div>
</div>
