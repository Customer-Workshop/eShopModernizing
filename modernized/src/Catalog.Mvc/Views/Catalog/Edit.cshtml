@model CatalogItemInputModel
@{
    ViewData["Title"] = "Edit";
}

<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src="@Url.RouteUrl("GetPicRouteTemplate", new { catalogItemId = Model.Id })" />
        <form asp-action="Edit" method="post" class="col-md-6 form-horizontal">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="Name" class="control-label col-md-4">Name</label>
                <div class="col-md-8">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="control-label col-md-4">Description</label>
                <div class="col-md-8">
                    <input asp-for="Description" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CatalogBrandId" class="control-label col-md-4">Brand</label>
                <div class="col-md-8">
                    <select asp-for="CatalogBrandId" asp-items="ViewBag.CatalogBrandId" class="form-control"></select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CatalogTypeId" class="control-label col-md-4">Type</label>
                <div class="col-md-8">
                    <select asp-for="CatalogTypeId" asp-items="ViewBag.CatalogTypeId" class="form-control"></select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Price" class="control-label col-md-4">Price</label>
                <div class="col-md-8">
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PictureFileName" class="control-label col-md-4">Picture name</label>
                <div class="col-md-8">
                    <input asp-for="PictureFileName" class="form-control" readonly title="Not allowed for edition" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="AvailableStock" class="control-label col-md-4">Stock</label>
                <div class="col-md-8">
                    <input asp-for="AvailableStock" class="form-control" />
                    <span asp-validation-for="AvailableStock" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="RestockThreshold" class="control-label col-md-4">Restock</label>
                <div class="col-md-8">
                    <input asp-for="RestockThreshold" class="form-control" />
                    <span asp-validation-for="RestockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="MaxStockThreshold" class="control-label col-md-4">Max stock</label>
                <div class="col-md-8">
                    <input asp-for="MaxStockThreshold" class="form-control" />
                    <span asp-validation-for="MaxStockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 text-right esh-button-actions">
                    <a asp-action="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
