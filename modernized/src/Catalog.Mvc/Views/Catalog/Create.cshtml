@model CatalogItemInputModel
@{
    ViewData["Title"] = "Create";
}

<h2 class="esh-body-title">Create</h2>

<div>
    <form asp-action="Create" method="post" class="form-horizontal">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Name" class="control-label col-md-2">Name</label>
            <div class="col-md-3">
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="control-label col-md-2">Description</label>
            <div class="col-md-3">
                <input asp-for="Description" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CatalogBrandId" class="control-label col-md-2">Brand</label>
            <div class="col-md-3">
                <select asp-for="CatalogBrandId" asp-items="ViewBag.CatalogBrandId" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="CatalogTypeId" class="control-label col-md-2">Type</label>
            <div class="col-md-3">
                <select asp-for="CatalogTypeId" asp-items="ViewBag.CatalogTypeId" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Price" class="control-label col-md-2">Price</label>
            <div class="col-md-3">
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Picture name</label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label asp-for="AvailableStock" class="control-label col-md-2">Stock</label>
            <div class="col-md-3">
                <input asp-for="AvailableStock" class="form-control" />
                <span asp-validation-for="AvailableStock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="RestockThreshold" class="control-label col-md-2">Restock</label>
            <div class="col-md-3">
                <input asp-for="RestockThreshold" class="form-control" />
                <span asp-validation-for="RestockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="MaxStockThreshold" class="control-label col-md-2">Max stock</label>
            <div class="col-md-3">
                <input asp-for="MaxStockThreshold" class="form-control" />
                <span asp-validation-for="MaxStockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a asp-action="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <button type="submit" class="btn esh-button esh-button-primary">[ Create ]</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
