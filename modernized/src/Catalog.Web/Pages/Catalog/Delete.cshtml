@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = "Delete";
}

<h2 class="esh-body-title">Delete</h2>

<div class="container">
    <h3>Are you sure you want to delete this?</h3>
    <div class="row">
        <img class="col-md-6 esh-picture" src="/Pics/@Model.ProductToDelete.PictureFileName" />
        <dl class="col-md-6 dl-horizontal">
            <dt>Name</dt>
            <dd>@Model.ProductToDelete.Name</dd>

            <dt>Description</dt>
            <dd>@Model.ProductToDelete.Description</dd>

            <dt>Brand</dt>
            <dd>@Model.ProductToDelete.CatalogBrand?.Brand</dd>

            <dt>Type</dt>
            <dd>@Model.ProductToDelete.CatalogType?.Type</dd>

            <dt>Price</dt>
            <dd><span class="esh-price">@Model.ProductToDelete.Price</span></dd>

            <dt>Picture name</dt>
            <dd>@Model.ProductToDelete.PictureFileName</dd>

            <dt>Stock</dt>
            <dd>@Model.ProductToDelete.AvailableStock</dd>

            <dt>Restock</dt>
            <dd>@Model.ProductToDelete.RestockThreshold</dd>

            <dt>Max stock</dt>
            <dd>@Model.ProductToDelete.MaxStockThreshold</dd>

            <dt></dt>
            <dd class="text-right esh-button-actions">
                <form method="post">
                    <a asp-page="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <button type="submit" class="btn esh-button esh-button-primary">[ Delete ]</button>
                </form>
            </dd>
        </dl>
    </div>
</div>
