@page
@model CreateModel
@{
    ViewData["Title"] = "Create";
}

<h2 class="esh-body-title">Create</h2>

<div>
    <form method="post" class="form-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Name" class="control-label col-md-2">Name</label>
            <div class="col-md-3">
                <input asp-for="Input.Name" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Description" class="control-label col-md-2">Description</label>
            <div class="col-md-3">
                <input asp-for="Input.Description" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.CatalogBrandId" class="control-label col-md-2">Brand</label>
            <div class="col-md-3">
                <select asp-for="Input.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.CatalogTypeId" class="control-label col-md-2">Type</label>
            <div class="col-md-3">
                <select asp-for="Input.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.Price" class="control-label col-md-2">Price</label>
            <div class="col-md-3">
                <input asp-for="Input.Price" class="form-control" />
                <span asp-validation-for="Input.Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Picture name</label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.AvailableStock" class="control-label col-md-2">Stock</label>
            <div class="col-md-3">
                <input asp-for="Input.AvailableStock" class="form-control" />
                <span asp-validation-for="Input.AvailableStock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.RestockThreshold" class="control-label col-md-2">Restock</label>
            <div class="col-md-3">
                <input asp-for="Input.RestockThreshold" class="form-control" />
                <span asp-validation-for="Input.RestockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Input.MaxStockThreshold" class="control-label col-md-2">Max stock</label>
            <div class="col-md-3">
                <input asp-for="Input.MaxStockThreshold" class="form-control" />
                <span asp-validation-for="Input.MaxStockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a asp-page="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <button type="submit" class="btn esh-button esh-button-primary">[ Create ]</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
