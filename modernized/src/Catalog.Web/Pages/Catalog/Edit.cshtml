@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Edit";
}

<h2 class="esh-body-title">Edit</h2>

<div class="container">
    <div class="row">
        <img class="col-md-6 esh-picture" src="/Pics/@Model.Input.PictureFileName" />
        <form method="post" class="col-md-6 form-horizontal">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Input.Id" />

            <div class="form-group">
                <label asp-for="Input.Name" class="control-label col-md-4">Name</label>
                <div class="col-md-8">
                    <input asp-for="Input.Name" class="form-control" />
                    <span asp-validation-for="Input.Name" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Description" class="control-label col-md-4">Description</label>
                <div class="col-md-8">
                    <input asp-for="Input.Description" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.CatalogBrandId" class="control-label col-md-4">Brand</label>
                <div class="col-md-8">
                    <select asp-for="Input.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.CatalogTypeId" class="control-label col-md-4">Type</label>
                <div class="col-md-8">
                    <select asp-for="Input.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.Price" class="control-label col-md-4">Price</label>
                <div class="col-md-8">
                    <input asp-for="Input.Price" class="form-control" />
                    <span asp-validation-for="Input.Price" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.PictureFileName" class="control-label col-md-4">Picture name</label>
                <div class="col-md-8">
                    <input asp-for="Input.PictureFileName" class="form-control" readonly title="Not allowed for edition" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.AvailableStock" class="control-label col-md-4">Stock</label>
                <div class="col-md-8">
                    <input asp-for="Input.AvailableStock" class="form-control" />
                    <span asp-validation-for="Input.AvailableStock" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.RestockThreshold" class="control-label col-md-4">Restock</label>
                <div class="col-md-8">
                    <input asp-for="Input.RestockThreshold" class="form-control" />
                    <span asp-validation-for="Input.RestockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Input.MaxStockThreshold" class="control-label col-md-4">Max stock</label>
                <div class="col-md-8">
                    <input asp-for="Input.MaxStockThreshold" class="form-control" />
                    <span asp-validation-for="Input.MaxStockThreshold" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-12 text-right esh-button-actions">
                    <a asp-page="Index" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                    <button type="submit" class="btn esh-button esh-button-primary">[ Save ]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
