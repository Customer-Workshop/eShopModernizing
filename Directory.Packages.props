<Project>

  <!--
    Central package management for the modernized .NET 8 solution (eShop.sln):
    exactly one version per package, declared here and nowhere else.

    Scoped to src/ and tests/ for the same reason as Directory.Build.props: the legacy
    .NET Framework projects keep their own inline PackageReference versions.
  -->
  <PropertyGroup>
    <_RepoRootNormalized>$(MSBuildThisFileDirectory.Replace('\','/'))</_RepoRootNormalized>
    <_ProjectDirNormalized>$(MSBuildProjectDirectory.Replace('\','/'))/</_ProjectDirNormalized>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ManagePackageVersionsCentrally Condition="$(_ProjectDirNormalized.StartsWith('$(_RepoRootNormalized)src/'))">true</ManagePackageVersionsCentrally>
    <ManagePackageVersionsCentrally Condition="$(_ProjectDirNormalized.StartsWith('$(_RepoRootNormalized)tests/'))">true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled Condition="'$(ManagePackageVersionsCentrally)' == 'true'">true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(ManagePackageVersionsCentrally)' == 'true'">
    <!-- ASP.NET Core / gRPC -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.63.0" />

    <!-- Logging (NET-62): replaces log4net -->
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />

    <!-- Telemetry (NET-62): replaces the Application Insights HTTP modules -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.3.0" />

    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />

    <!-- Configuration / dependency injection -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />

    <!-- Data access -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
